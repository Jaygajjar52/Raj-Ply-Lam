# Supabase PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"

# Admin login for the private inquiry dashboard
ADMIN_PHONE="9427049594"
ADMIN_PASSWORD="your-private-pin"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
# Use Lax for local HTTP development. Use None only for HTTPS cross-domain production.
ADMIN_COOKIE_SAMESITE="Lax"

# Frontend origin allowed to call this API. Use comma-separated values for multiple domains.
CLIENT_ORIGIN="http://localhost:5173"

# Express server port
PORT=4000
